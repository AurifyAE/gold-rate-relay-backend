{% comment %}
  Compact live spot-rate display. The existing gold-rate-relay.js asset
  updates these values through the page's single Socket.IO connection.
{% endcomment %}

<div
  class="gold-rate-bar"
  data-gold-rate-bar
  data-state="loading"
  role="region"
  aria-label="Live precious metal rates"
>
  <div class="gold-rate-bar__inner">
    <div class="gold-rate-bar__status">
      <span class="gold-rate-bar__indicator" aria-hidden="true"></span>
      <span data-live-market-status aria-live="polite">Connecting</span>
    </div>

    <div class="gold-rate-bar__rates">
      <div class="gold-rate-bar__rate">
        <span class="gold-rate-bar__label">Gold 24K spot</span>
        <strong data-live-gold-rate>Loading</strong>
      </div>

      <div class="gold-rate-bar__rate">
        <span class="gold-rate-bar__label">Silver spot</span>
        <strong data-live-silver-rate>Loading</strong>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .gold-rate-bar {
    --gold-rate-status-color: rgb(var(--color-foreground-rgb) / 0.38);

    position: relative;
    width: 100%;
    color: rgb(var(--color-foreground-rgb));
    background: rgb(var(--color-background-rgb));
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .gold-rate-bar[data-state='live'] {
    --gold-rate-status-color: #2f7d5c;
  }

  .gold-rate-bar[data-state='closed'] {
    --gold-rate-status-color: #a96a25;
  }

  .gold-rate-bar[data-state='offline'] {
    --gold-rate-status-color: #a34141;
  }

  .gold-rate-bar__inner {
    min-height: 2.25rem;
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding: 0.45rem clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    font-family: inherit;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .gold-rate-bar__status,
  .gold-rate-bar__rate,
  .gold-rate-bar__rates {
    display: flex;
    align-items: center;
  }

  .gold-rate-bar__status {
    flex: 0 0 auto;
    gap: 0.45rem;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .gold-rate-bar__indicator {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--gold-rate-status-color);
  }

  .gold-rate-bar__rates {
    justify-content: flex-end;
    gap: clamp(1rem, 4vw, 3rem);
    font-variant-numeric: tabular-nums;
  }

  .gold-rate-bar__rate {
    gap: 0.55rem;
    white-space: nowrap;
  }

  .gold-rate-bar__label {
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .gold-rate-bar__rate strong {
    color: rgb(var(--color-foreground-rgb));
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  @media screen and (max-width: 749px) {
    .gold-rate-bar__inner {
      min-height: 2.5rem;
      gap: 0.75rem;
      padding-inline: 0.85rem;
      font-size: 0.68rem;
    }

    .gold-rate-bar__status {
      max-width: 5.5rem;
    }

    .gold-rate-bar__rates {
      flex: 1 1 auto;
      justify-content: space-between;
      gap: 0.65rem;
    }

    .gold-rate-bar__rate {
      display: grid;
      gap: 0.12rem;
    }

    .gold-rate-bar__label {
      font-size: 0.62rem;
    }

    .gold-rate-bar__rate strong {
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gold-rate-bar *,
    .gold-rate-bar *::before,
    .gold-rate-bar *::after {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstylesheet %}
