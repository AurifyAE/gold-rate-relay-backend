PORT=10000

# Private upstream socket settings. Never put these in Shopify theme files.
UPSTREAM_SOCKET_URL=https://capital.com
UPSTREAM_SOCKET_SECRET=replace-with-a-new-secret

# Public browser origins allowed to connect to this relay.
ALLOWED_ORIGINS=https://your-store.com,https://your-store.myshopify.com

# UAE pricing configuration.
USD_TO_AED=3.674
VAT_RATE=0.05
DIAMOND_RATE=18000

# JSON object containing the current jewellery retail rates.
DJG_RETAIL_RATES_JSON={"24K":582.25,"22K":539,"21K":517,"18K":443,"14K":345.5}

# Used only for updating DJG rates through PUT /api/admin/rates.
ADMIN_API_KEY=replace-with-a-long-admin-key
